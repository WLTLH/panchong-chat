.page { padding: 24rpx 24rpx 48rpx; box-sizing: border-box; }

.hero {
  background: #121418;
  color: #E8DCC8;
  border-radius: 20rpx;
  padding: 28rpx 24rpx 22rpx;
  margin-bottom: 20rpx;
}
.hero-title { font-size: 34rpx; font-weight: 800; margin-bottom: 10rpx; }
.hero-meta {
  display: flex; flex-wrap: wrap; gap: 16rpx;
  font-size: 22rpx; color: rgba(230,215,180,0.75); margin-bottom: 16rpx;
}
.bar { height: 8rpx; background: rgba(255,255,255,0.12); border-radius: 8rpx; overflow: hidden; }
.bar-fill {
  height: 100%; background: #E67E22;
  transition: width 0.45s ease;
}

.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.04);
}
.section-title { font-size: 28rpx; font-weight: 700; margin-bottom: 16rpx; color: #222; }
.muted { font-size: 24rpx; color: #888; line-height: 1.5; }

/* —— CAD 枪口模型 —— */
.stage-card {
  padding: 0;
  overflow: hidden;
  background: #121418;
  transition: box-shadow 0.3s;
}
.stage-card.shock {
  animation: shockFlash 0.7s ease;
}
@keyframes shockFlash {
  0%, 100% { box-shadow: 0 0 0 rgba(232,93,93,0); }
  40% { box-shadow: 0 0 40rpx rgba(232,93,93,0.45); }
}
.stage { position: relative; padding-bottom: 8rpx; }
.cad-frame {
  position: relative;
  width: 100%;
  height: 0;
  padding-bottom: 66.67%;
  overflow: hidden;
}
.cad-layer {
  position: absolute;
  left: 0; top: 0; width: 100%; height: 100%;
}
.cad-base, .cad-mark {
  position: absolute;
  left: 0; top: 0; width: 100%; height: 100%;
  display: block;
}
.mark-pair {
  position: absolute;
  left: 0; top: 0; width: 100%; height: 100%;
  z-index: 5;
  pointer-events: none;
}
.mark-grey { opacity: 0.9; }
.mark-lit { opacity: 0; z-index: 6; transition: opacity 0.35s ease; }
.mark-pair.is-lit .mark-grey { opacity: 0.25; }
.mark-pair.is-lit .mark-lit { opacity: 1; }
.mark-pair.is-lit .mark-lit.tone-fail {
  animation: failPulse 1.2s ease-in-out infinite;
}
@keyframes failPulse {
  0%, 100% { filter: brightness(1); }
  50% { filter: brightness(1.25); }
}
.shot {
  position: absolute;
  left: 16rpx; top: 16rpx; z-index: 7;
  display: flex; flex-direction: column; gap: 4rpx;
  pointer-events: none;
}
.shot-t { font-size: 20rpx; color: rgba(230,215,180,0.85); letter-spacing: 1rpx; }
.shot-title { font-size: 28rpx; font-weight: 800; color: #F2E6D0; }
.caption {
  padding: 12rpx 20rpx 18rpx;
  font-size: 24rpx;
  color: rgba(230,215,180,0.9);
  line-height: 1.45;
}

/* —— 链路舞台 —— */
.chain-card {
  background: #121418;
  color: #E8DCC8;
}

.chain-head {
  display: flex; justify-content: space-between; align-items: center;
  margin-bottom: 28rpx;
}
.chain-label {
  font-size: 20rpx; letter-spacing: 2rpx;
  color: rgba(230,215,180,0.7);
}
.chain-banner {
  font-size: 22rpx; font-weight: 800;
  padding: 8rpx 16rpx; border-radius: 999rpx;
}
.banner-run { background: rgba(76,141,255,0.2); color: #9DC0FF; }
.banner-bad { background: rgba(232,93,93,0.25); color: #FFB0B0; }

.chain {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 0;
  margin-bottom: 28rpx;
  overflow-x: auto;
  padding: 8rpx 0 16rpx;
}

.node-wrap { flex-shrink: 0; }
.node {
  width: 112rpx;
  min-height: 132rpx;
  border-radius: 16rpx;
  background: #1C2128;
  border: 2rpx solid #2A313A;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 12rpx 8rpx;
  box-sizing: border-box;
  position: relative;
  transition: transform 0.35s ease, border-color 0.35s, background 0.35s;
}
.node-name { font-size: 24rpx; font-weight: 800; color: #D0D4DA; }
.node-sub { font-size: 16rpx; color: rgba(200,200,200,0.55); margin-top: 4rpx; text-align: center; }
.node-x {
  position: absolute;
  top: -10rpx; right: -8rpx;
  width: 36rpx; height: 36rpx;
  border-radius: 50%;
  background: #E85D5D;
  color: #fff;
  font-size: 22rpx; font-weight: 900;
  display: flex; align-items: center; justify-content: center;
  animation: popIn 0.35s ease;
}
@keyframes popIn {
  from { transform: scale(0.3); opacity: 0; }
  to { transform: scale(1); opacity: 1; }
}

.node.st-idle { opacity: 0.45; }
.node.st-run {
  border-color: #4C8DFF;
  background: rgba(47,107,255,0.18);
  animation: nodePulse 1.1s ease-in-out infinite;
}
.node.st-run .node-name { color: #B8D0FF; }
.node.st-ok {
  border-color: #1DBF6E;
  background: rgba(29,191,110,0.16);
}
.node.st-ok .node-name { color: #7DFFB2; }
.node.st-fail, .node.break {
  border-color: #E85D5D;
  background: rgba(232,93,93,0.2);
  transform: scale(1.06);
}
.node.st-fail .node-name, .node.break .node-name { color: #FFB0B0; }
.node.st-block {
  border-color: #5A5F66;
  background: #181C22;
  opacity: 0.55;
}
.node.st-block .node-name { color: #7A8088; text-decoration: line-through; }
.node.focus:not(.st-fail) {
  transform: scale(1.05);
}

@keyframes nodePulse {
  0%, 100% { box-shadow: 0 0 0 0 rgba(76,141,255,0.35); }
  50% { box-shadow: 0 0 0 10rpx rgba(76,141,255,0); }
}

.link {
  flex: 1;
  min-width: 28rpx;
  height: 40rpx;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}
.link-rail {
  position: absolute;
  left: 0; right: 0;
  height: 4rpx;
  background: #2A313A;
  border-radius: 4rpx;
}
.link-flow {
  position: absolute;
  left: 0; width: 40%; height: 4rpx;
  border-radius: 4rpx;
  background: linear-gradient(90deg, transparent, #4C8DFF, #7DFFB2);
  animation: flowMove 0.9s linear infinite;
}
.lk-on .link-rail { background: rgba(29,191,110,0.35); }
.lk-on .link-flow {
  width: 100%;
  background: #1DBF6E;
  animation: none;
  opacity: 0.85;
}
.lk-cut .link-rail {
  background: repeating-linear-gradient(90deg, #5A5F66 0 6rpx, transparent 6rpx 12rpx);
  opacity: 0.7;
}
.link-cut {
  position: relative;
  z-index: 2;
  color: #E85D5D;
  font-size: 28rpx;
  font-weight: 900;
  background: #121418;
  padding: 0 4rpx;
  animation: popIn 0.3s ease;
}
@keyframes flowMove {
  from { transform: translateX(-80%); }
  to { transform: translateX(220%); }
}

.shot-line { display: flex; align-items: baseline; gap: 12rpx; margin-bottom: 8rpx; }
.shot-t { font-size: 20rpx; color: rgba(230,215,180,0.7); }
.shot-title { font-size: 30rpx; font-weight: 800; color: #F2E6D0; }
.narr { font-size: 24rpx; line-height: 1.5; color: rgba(230,215,180,0.88); }

.break-tip {
  margin-top: 18rpx;
  padding: 14rpx 16rpx;
  border-radius: 12rpx;
  background: rgba(232,93,93,0.15);
  border: 1rpx solid rgba(232,93,93,0.35);
  font-size: 22rpx;
  color: #FFC4C4;
}
.break-tip .em { color: #FF8A8A; font-weight: 800; }

.metric-row { display: flex; gap: 12rpx; flex-wrap: wrap; }
.metric {
  flex: 1; min-width: 28%;
  background: #F7F8FA; border-radius: 12rpx; padding: 14rpx;
}
.m-k { display: block; font-size: 20rpx; color: #999; }
.m-v { font-size: 28rpx; font-weight: 700; color: #222; }

.tl-item {
  display: flex; gap: 14rpx;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #F0F0F0;
}
.tl-dot {
  width: 16rpx; height: 16rpx; border-radius: 50%;
  background: #D0D0D0; margin-top: 8rpx; flex-shrink: 0;
}
.tl-done .tl-dot { background: #07C160; }
.tl-active .tl-dot {
  background: #2F6BFF;
  box-shadow: 0 0 0 6rpx rgba(47,107,255,0.18);
}
.tl-broken .tl-title { color: #C94444; }
.tl-body { display: flex; flex-direction: column; gap: 2rpx; }
.tl-t { font-size: 20rpx; color: #999; }
.tl-title { font-size: 26rpx; font-weight: 600; color: #333; }
.tl-active .tl-title { color: #2F6BFF; }

.lean-label { font-size: 30rpx; font-weight: 800; color: #E67E22; margin-bottom: 8rpx; }

.controls { display: flex; gap: 12rpx; margin-bottom: 12rpx; }
.controls.sub { margin-bottom: 24rpx; }
.btn-primary, .btn-ghost {
  flex: 1; text-align: center;
  padding: 22rpx 12rpx; border-radius: 14rpx;
  font-size: 26rpx; font-weight: 700;
}
.btn-primary { background: #07C160; color: #fff; }
.btn-ghost { background: #fff; color: #333; border: 1rpx solid #E5E5E5; }
