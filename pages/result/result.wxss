.verdict {
  color: #fff;
  margin-top: 24rpx;
}
.v-label { font-size: 40rpx; font-weight: 700; }
.v-sum { margin-top: 12rpx; font-size: 26rpx; opacity: 0.95; line-height: 1.6; }

.score-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin: 16rpx 0;
}
.score-name { width: 80rpx; font-size: 26rpx; }
.score-track {
  flex: 1;
  height: 16rpx;
  background: #EEEEEE;
  border-radius: 8rpx;
  overflow: hidden;
}
.score-fill { height: 100%; border-radius: 8rpx; }
.score-val { width: 48rpx; text-align: right; font-size: 26rpx; }

.advice { padding: 8rpx 0; font-size: 26rpx; line-height: 1.6; }

.ev {
  display: flex;
  gap: 12rpx;
  align-items: flex-start;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #F0F0F0;
}
.ev-text { flex: 1; font-size: 26rpx; }

.tl {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #F5F5F5;
  font-size: 24rpx;
}

.footer-actions { margin: 24rpx; padding-bottom: 40rpx; }

.lock-card { margin: 24rpx; }
.free-title {
  font-size: 44rpx;
  font-weight: 800;
  color: #222;
  margin-bottom: 12rpx;
}
.free-desc {
  font-size: 28rpx;
  color: #555;
  line-height: 1.55;
  margin-bottom: 20rpx;
}
.lock-tip {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 28rpx;
}
