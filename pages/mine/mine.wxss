.page {
  min-height: 100vh;
  padding-bottom: 48rpx;
  background: #F5F6F8;
}

.hero {
  position: relative;
  overflow: hidden;
}
.hero-bg {
  position: absolute;
  left: 0; right: 0; top: 0;
  height: 200rpx;
  background: linear-gradient(135deg, #07C160 0%, #06AD56 55%, #059A4D 100%);
}
.hero-inner {
  position: relative;
  padding: 88rpx 40rpx 28rpx;
  color: #fff;
}
.hero-title {
  font-size: 40rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
}

.card {
  margin: 20rpx 24rpx;
  padding: 28rpx;
  background: #fff;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.profile-card { margin-top: 20rpx; }

.profile-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.avatar-btn {
  padding: 0;
  margin: 0;
  background: transparent;
  border: none;
  line-height: 1;
}
.avatar-btn::after { border: none; }

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: #F0F0F0;
  flex-shrink: 0;
}

.profile-info {
  flex: 1;
  min-width: 0;
}

.nick-input {
  font-size: 34rpx;
  font-weight: 700;
  color: #1A1A1A;
  height: 48rpx;
  line-height: 48rpx;
}

.uid {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #666;
}

.login-time {
  margin-top: 4rpx;
  font-size: 22rpx;
}

.vip-badge {
  flex-shrink: 0;
  padding: 8rpx 16rpx;
  border-radius: 12rpx;
  background: #F0F0F0;
  color: #888;
  font-size: 22rpx;
  font-weight: 600;
}
.vip-badge.vip-on {
  background: #FFF3E0;
  color: #E67E22;
}

.auth-card {
  padding-top: 0;
  overflow: hidden;
}

.auth-tabs {
  display: flex;
  margin: 0 -28rpx 0;
  border-bottom: 1rpx solid #F0F0F0;
}

.auth-tab {
  flex: 1;
  text-align: center;
  padding: 28rpx 0;
  font-size: 30rpx;
  color: #888;
  position: relative;
}

.auth-tab.active {
  color: #07C160;
  font-weight: 700;
}

.auth-tab.active::after {
  content: '';
  position: absolute;
  left: 50%;
  bottom: 0;
  width: 48rpx;
  height: 6rpx;
  margin-left: -24rpx;
  background: #07C160;
  border-radius: 3rpx;
}

.auth-body {
  padding: 40rpx 8rpx 12rpx;
  text-align: center;
}

.auth-logo {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: #F0F0F0;
}

.auth-title {
  margin-top: 24rpx;
  font-size: 34rpx;
  font-weight: 700;
  color: #1A1A1A;
}

.auth-hint {
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.5;
}

.btn-wechat {
  margin-top: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  background: #07C160;
  color: #fff;
  padding: 24rpx 0;
  border-radius: 48rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.wechat-mark {
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  text-align: center;
  border-radius: 8rpx;
  background: rgba(255, 255, 255, 0.25);
  font-size: 22rpx;
  font-weight: 700;
}

.auth-foot {
  margin-top: 24rpx;
  font-size: 22rpx;
}

.btn-row {
  margin-top: 24rpx;
}
.btn-ghost {
  text-align: center;
  padding: 18rpx 0;
  border-radius: 48rpx;
  border: 2rpx solid #E5E5E5;
  color: #666;
  font-size: 26rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #F0F0F0;
}
.menu-item:last-child { border-bottom: none; }
.menu-k {
  font-size: 28rpx;
  color: #1A1A1A;
}
.menu-v {
  flex: 1;
  text-align: right;
  font-size: 24rpx;
  color: #07C160;
  margin-right: 8rpx;
}
.menu-v.muted { color: #888; }
.menu-arrow {
  color: #CCC;
  font-size: 32rpx;
  line-height: 1;
}

.about-desc {
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.5;
}

.mono {
  font-family: Consolas, Monaco, monospace;
}

.muted { color: #888; }
