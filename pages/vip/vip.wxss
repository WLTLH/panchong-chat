.page {
  padding: 32rpx 28rpx 64rpx;
  background: #F5F6F8;
  min-height: 100vh;
  box-sizing: border-box;
}
.hero {
  background: linear-gradient(135deg, #1a222c, #0f1419);
  color: #fff;
  border-radius: 20rpx;
  padding: 36rpx 28rpx;
  margin-bottom: 24rpx;
}
.h1 { font-size: 40rpx; font-weight: 800; }
.h2 { margin-top: 12rpx; font-size: 26rpx; color: rgba(255,255,255,0.75); }
.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}
.section-title { font-size: 28rpx; font-weight: 700; margin-bottom: 12rpx; }
.li { font-size: 26rpx; color: #444; line-height: 1.7; }
.status {
  text-align: center;
  margin: 16rpx 0 24rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #07C160;
}
.status.off { color: #888; }
.btn-primary, .btn-ghost {
  text-align: center;
  padding: 28rpx;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 700;
  margin-bottom: 16rpx;
}
.btn-primary { background: #07C160; color: #fff; }
.btn-ghost {
  background: #fff;
  color: #666;
  border: 2rpx solid #ddd;
}
.tip { font-size: 22rpx; color: #999; line-height: 1.5; margin-top: 8rpx; }
.muted { color: #999; }
