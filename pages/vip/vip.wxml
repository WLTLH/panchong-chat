<view class="page">
  <view class="hero">
    <view class="h1">会员版</view>
    <view class="h2">看清依据，不只给三字结论</view>
  </view>

  <view class="card">
    <view class="section-title">免费版</view>
    <view class="li">· 连接页结论：车端问题 / 桩端问题 / 建议换桩</view>
    <view class="li">· 插枪通信是否建立</view>
  </view>

  <view class="card">
    <view class="section-title">会员版解锁</view>
    <view class="li">· 完整倾向说明与三维评分</view>
    <view class="li">· 依据条目、BST/CST 位域解读</view>
    <view class="li">· 会话阶段时间线与报文摘要</view>
    <view class="li">· 充电慢：BCL/CML/CCS 曲线与判定</view>
    <view class="li">· 报文字段级解析</view>
  </view>

  <view class="status" wx:if="{{isVip}}">当前已是会员</view>
  <view class="status off" wx:else>当前为免费版</view>

  <view class="btn-primary" bindtap="onUnlock" wx:if="{{!isVip}}">开通会员（演示）</view>
  <view class="btn-ghost" bindtap="onLock" wx:if="{{isVip}}">退出会员（演示）</view>
  <view class="muted tip">正式支付接口可后续接入；此处先用本地开关演示收费分层。</view>
</view>
