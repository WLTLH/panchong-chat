<view class="page">
  <view class="session-card" wx:if="{{hasSession}}">
    <view class="session-tag">{{sessionTag || '会话'}} · {{lineCount}} 行</view>
    <view class="session-head">{{sessionHeadline}}</view>
    <view class="session-verdict" wx:if="{{sessionVerdict}}">{{sessionVerdict}}</view>
    <view class="session-row" wx:for="{{sessionRows}}" wx:key="label">
      <text class="session-k">{{item.label}}</text>
      <text class="session-v">{{item.value}}</text>
    </view>
    <view class="session-alert" wx:for="{{sessionAlerts}}" wx:key="code">
      {{item.code}} {{item.time}} {{item.data}} {{item.text}}
    </view>
    <view class="session-link" bindtap="goConnect">连接页看详情 ›</view>
  </view>
  <view class="session-empty" wx:else>
    <view class="session-empty-title">暂无充电报文</view>
    <view class="session-empty-sub">连采集盒，或点「直流充电模拟器」开始灌数据</view>
  </view>

  <view class="card">
    <view class="section-title">工具</view>
    <view
      class="entry {{item.id==='verdictguide'?'entry-pan':(item.id==='abcompare'?'entry-yi':(item.id==='dbcvw'?'entry-ju':(item.id==='dcsim'?'entry-sim':(item.id==='cellhealth'?'entry-cell':(item.id==='cellhealth_soh'?'entry-soh':'')))))}}"
      wx:for="{{entries}}"
      wx:key="id"
      data-url="{{item.url}}"
      bindtap="onEntry"
    >
      <view class="entry-title">{{item.title}}</view>
      <view class="muted">{{item.desc}}</view>
    </view>
  </view>
</view>
