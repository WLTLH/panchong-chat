<view class="page">
  <view class="card" wx:if="{{!hasTrace}}">
    <view class="empty-title">暂无报文数据</view>
    <view class="muted">请先在「连接」页连接采集盒并采集一段充电日志，采集完成后会自动显示曲线。</view>
    <view class="btn-main" bindtap="goConnect">去连接采集</view>
  </view>

  <view class="card" wx:if="{{hasTrace}}">
    <view class="section-title">车辆信息</view>
    <view class="kv"><text class="k">VIN</text><text class="v mono">{{readable.vin}}</text></view>
    <view class="kv"><text class="k">电池类型</text><text class="v">{{readable.batteryType}}</text></view>
    <view class="kv"><text class="k">SOC</text><text class="v">{{readable.soc}}</text></view>
    <view class="kv"><text class="k">桩ID</text><text class="v">{{readable.pileId}}</text></view>
    <view class="muted" style="margin-top:12rpx;">{{readable.note}}</view>
  </view>

  <view class="card chart-card" wx:if="{{hasTrace}}">
    <view class="section-title">充电慢 · 需求 / 能力 / 实出</view>
    <view class="legend">
      <text class="lg ireq">车需求 BCL</text>
      <text class="lg iout">桩实出 CCS</text>
      <text class="lg icml">桩能力 CML</text>
    </view>
    <canvas canvas-id="speedCanvas" class="canvas" style="width:{{canvasW}}px;height:{{speedCanvasH}}px;"></canvas>
    <view class="speed-verdict" wx:if="{{speedVerdict && isVip}}" style="border-left-color:{{speedVerdict.color}};">
      <view class="speed-label" style="color:{{speedVerdict.color}};">{{speedVerdict.label}}</view>
      <view class="speed-sum">{{speedVerdict.summary}}</view>
      <view class="speed-nums" wx:if="{{speedNumText}}">{{speedNumText}}</view>
      <view class="muted" style="margin-top:8rpx;">{{speedVerdict.disclaimer}}</view>
    </view>
    <view class="speed-verdict lock" wx:elif="{{speedVerdict && !isVip}}">
      <view class="speed-label">{{freeSpeedTitle}}</view>
      <view class="speed-sum">{{freeSpeedDesc}}</view>
      <view class="btn-vip" bindtap="goVip">开通会员看曲线判定详情</view>
    </view>
  </view>

  <view class="card chart-card" wx:if="{{hasTrace}}">
    <view class="section-title">SOC / 电流幅值|I| / 绝缘状态</view>
    <view class="legend">
      <text class="lg soc">SOC%</text>
      <text class="lg iout">输出|I|</text>
      <text class="lg ireq">需求|I|</text>
      <text class="lg ins">绝缘状态</text>
    </view>
    <canvas canvas-id="seriesCanvas" class="canvas" style="width:{{canvasW}}px;height:{{canvasH}}px;"></canvas>
  </view>
</view>
