.chips { display: flex; flex-wrap: wrap; gap: 12rpx; margin-bottom: 16rpx; }
.chip {
  padding: 8rpx 18rpx;
  background: #F0F0F0;
  border-radius: 24rpx;
  font-size: 24rpx;
}
.log-area {
  width: 100%;
  min-height: 180rpx;
  background: #F7F8FA;
  border-radius: 12rpx;
  padding: 16rpx;
  box-sizing: border-box;
}
.btn-primary.sm { padding: 16rpx 36rpx; border-radius: 40rpx; font-size: 28rpx; }
.sum { margin: 12rpx 0; font-size: 28rpx; font-weight: 600; }
.mfr-tag {
  display: inline-block;
  margin-top: 8rpx;
  padding: 6rpx 14rpx;
  background: #E8F8EF;
  color: #07C160;
  border-radius: 8rpx;
  font-size: 24rpx;
  font-weight: 600;
}
.field {
  padding: 12rpx 0;
  border-bottom: 1rpx solid #F5F5F5;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}
.fname { color: #888; font-size: 22rpx; }
.fval { font-size: 28rpx; }
.batch-line {
  display: flex;
  gap: 16rpx;
  padding: 8rpx 0;
  font-size: 24rpx;
  border-bottom: 1rpx solid #F8F8F8;
}
